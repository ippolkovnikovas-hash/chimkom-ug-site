# Пароль приложения mail.ru для отправки писем
MAIL_PASSWORD=ваш_пароль_приложения_от_почты

# Секретный ключ Flask (сгенерируйте свой)
SECRET_KEY=поменяйте-на-случайную-строку

# Куда приходят письма с формы «Контакты» (необязательно, ниже значения по умолчанию)
# Краснодарский край и Ростовская область:
# CONTACT_EMAIL_KRASNODAR=chimkom-ug@mail.ru
# Республики и «Другой регион» (также форма в футере и «Заказать звонок»):
# CONTACT_EMAIL=himkom-ug@mail.ru

# --- SEO (все необязательные; пусто — соответствующий код на сайте не выводится) ---
# Канонический адрес сайта без слэша в конце
# SITE_URL=https://himkom-ug.ru
# Номер счётчика Яндекс.Метрики (только цифры)
# YANDEX_METRIKA_ID=
# Коды подтверждения прав на сайт (значение content мета-тега из Яндекс.Вебмастера / Google Search Console)
# YANDEX_VERIFICATION=
# GOOGLE_VERIFICATION=

# Ссылка на профиль в Max (в приложении: Контакты → «Пригласить по ссылке»), вида https://max.ru/u/...
# Пусто — значок Max на сайте не показывается
# MAX_URL=
