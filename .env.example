# Пароль приложения mail.ru для отправки писем
MAIL_PASSWORD=ваш_пароль_приложения_от_почты

# Секретный ключ Flask (сгенерируйте свой)
SECRET_KEY=поменяйте-на-случайную-строку

# Куда приходят письма с формы «Контакты» (необязательно, ниже значения по умолчанию)
# Краснодарский край и Ростовская область:
# CONTACT_EMAIL_KRASNODAR=chimkom-ug@mail.ru
# Республики и «Другой регион» (также форма в футере и «Заказать звонок»):
# CONTACT_EMAIL=himkom-ug@mail.ru
